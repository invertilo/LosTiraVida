# NASA API Configuration
# Get your API key from https://api.nasa.gov
# VITE_NASA_API_KEY=your_nasa_api_key_here

# API Endpoints (optional, use defaults if not set)
# VITE_NASA_API_ENDPOINT=https://api.nasa.gov

# Environment
# VITE_ENVIRONMENT=development

# Feature Flags
# VITE_ENABLE_ADVANCED_PHYSICS=true
# VITE_ENABLE_MULTIPLAYER=false

# Analytics (optional)
# VITE_GA_ID=your_google_analytics_id

# Notes:
# - Variables prefixed with VITE_ are exposed to the browser
# - Create a .env.local file with your actual values
# - Never commit .env.local to version control
# - Only include variables your app actually uses
